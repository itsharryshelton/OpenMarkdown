{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openmarkdown",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	},
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.md"
			],
			"fallthrough": true
		}
	],
	"routes": [],
	"vars": {
		"CF_ACCESS_TEAM_NAME": ""
	}
	/**
	 * Following secrets in use from CF Side.
	 *
	 * CF_ACCESS_AUDIENCE
	 */
}